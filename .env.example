# AlphaGuard environment template — copy to .env (never commit .env)

# Replay-first default (smoke must not require Kafka)
ALPHAGUARD_MODE=replay
ALPHAGUARD_RAG_MODE=fixture

# Host Ollama — default gemma4:e2b; fallback qwen3.5:4b
# gemma4:e2b may 412 on older Ollama — upgrade Ollama OR set OLLAMA_MODEL=qwen3.5:4b
OLLAMA_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FALLBACK_MODEL=qwen3.5:4b

# macOS: XGBoost needs `brew install libomp`. Smoke sets KMP_DUPLICATE_LIB_OK=TRUE.

# Compose services (optional for smoke)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=alphaguard_news

# Observability — best-effort / fail-open (local run summary always written)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=alphaguard
PHOENIX_ENABLED=false
